 1.5rem; \/* Slightly bigger label text *\/\n}\n\n\/* Field wrapper spacing *\/\n.field.custom {\n  margin-top: 0.4rem;\n}\n\n\/* Input box styling *\/\n.custom .field__input {\n  padding: 1.7rem 1.5rem; \/* Taller input box *\/\n  border-radius: 25px;\n  border: 1px solid #ddd;\n  font-size: 1.4rem; \/* Bigger text size *\/\n  width: 100%;\n  box-sizing: border-box;\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\n\/* Placeholder styling *\/\n.custom .field__input::placeholder {\n  font-size: 1.4rem; \/* Bigger placeholder *\/\n  color: #999;\n \n}\n\n\/* On focus: highlight *\/\n.custom .field__input:focus {\n  border-color: #333; \/* Replace with theme accent color *\/\n  box-shadow: 0 0 0 2px rgba(0,0,0,0.05);\n  outline: none;\n}\n<\/style>\n\n<label class=\"form__label custom\" for=\"your-custom-text\">Your custom text (Optional)<\/label>\n<div class=\"field custom\">\n  <input class=\"field__input\" \n         form=\"{{ 'product-form-' | append: section.id }}\" \n         type=\"text\" \n         id=\"your-custom-text\" \n         name=\"properties[Your custom text]\" \n         placeholder=\"Type your text here...\">\n<\/div>"}},"custom_liquid_maeicj":{"type":"custom_liquid","name":"Custom Files","disabled":true,"settings":{"custom_liquid":"<style>.file-upload-container {display: flex;align-items: center;}.file-name {margin-left: 10px;font-style: italic;}\n.form__label {\n  margin-bottom: 0.6rem;\n  font-weight: 500;\n  font-size: 1.5rem;}\n<\/style>\n\n<div class=\"product-form__input\">\n  <label class=\"form__label\">Your custom files (Optional)<\/label>\n  <div class=\"file-upload-container\">\n    <input id=\"file-your-custom-files\" form=\"{{ 'product-form-' | append: section.id }}\" \n    name=\"properties[Custom file]\" multiple style=\"display: none;\" type=\"file\"  \/>\n    <button id=\"button-your-custom-files\" class=\"button\">Upload Files<\/button>\n    <p id=\"fileName-your-custom-files\" class=\"file-name\">No file chosen<\/p>\n    <\/div>\n    <p id=\"errorMessage\" class=\"error-message\" style=\"display: none;margin-top:0;color:red\">Please upload your file(s).<\/p>\n<\/div>\n<script>\ndocument.getElementById('file-your-custom-files').addEventListener('change', function(event) {\n      const files = event.target.files;\n    const fileInput = document.getElementById('file-your-custom-files');\n    const originalForm = fileInput.getAttribute('form');\n    fileInput.parentNode.querySelectorAll('.dynamic-hidden-input-your-custom-files').forEach(input => input.remove());\n    for (let i = 0; i < files.length-1; i++) {\n      const file = files[i];\n      const hiddenInput = document.createElement('input');\n      hiddenInput.type = 'file';\n      let myindex = i + 2\n      hiddenInput.name = 'properties[Custom file ' + myindex +']';\n      hiddenInput.classList.add('dynamic-hidden-input-your-custom-files');\n      hiddenInput.classList.add('hidden-input-fileupload');\n      hiddenInput.style.display = 'none';\n      hiddenInput.setAttribute('form', originalForm);\n      const dataTransfer = new DataTransfer();\n      dataTransfer.items.add(file);\n      hiddenInput.files = dataTransfer.files;\n      fileInput.parentNode.appendChild(hiddenInput);\n    }\n      let fileName;\n      if (files.length === 0) {fileName = 'No file chosen';} \n      else if (files.length === 1) {fileName = files[0].name;document.getElementById('errorMessage').style.display = 'none'; } \n      else {fileName = files.length + ' files';document.getElementById('errorMessage').style.display = 'none';}\n      document.getElementById('fileName-your-custom-files').textContent = fileName;\n  });\n  document.getElementById('button-your-custom-files').addEventListener('click', function() {\n  document.getElementById('file-your-custom-files').click();\n  });\n<\/script>"}},"expo_product_options_expo_block_XQG6Tm":{"type":"shopify:\/\/apps\/expo-product-options\/blocks\/expo-block\/07e9c3c4-4d7c-4540-8004-198ebcc5815d","set
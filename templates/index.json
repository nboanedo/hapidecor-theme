utton_link":"shopify:\/\/collections\/bathroom","button_style":"btn--primary","button_icon":"none","enable_preload_image":false}},"image_slide_gD7pcx":{"type":"image-slide","settings":{"color_scheme":"","image":"shopify:\/\/shop_images\/highlight.png","desktop_content_position":"top-left","desktop_content_alignment":"left","mobile_content_alignment":"left","subheading":"Where Craft Becomes the Statement","heading":"Home Highlights","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h2","text":"<p>Some furniture does more than fill a room—it sets the tone. These statement pieces celebrate material, form, and presence.<\/p>","text_size":"text-base","button_label":"Explore Now","button_link":"shopify:\/\/collections\/home-highlights","button_style":"btn--primary","button_icon":"none","enable_preload_image":false}},"image_slide_B4R7VQ":{"type":"image-slide","settings":{"color_scheme":"scheme-1","image":"shopify:\/\/shop_images\/office.png","desktop_content_position":"top-left","desktop_content_alignment":"left","mobile_content_alignment":"left","subheading":"Designed for Focus and Flow","heading":"Home Office","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h2","text":"<p>Your workspace should support clarity, not distract from it. Natural wood creates a grounded environment that feels human and calm.<\/p>","text_size":"text-base","button_label":"Explore Now","button_link":"shopify:\/\/collections\/home-office","button_style":"btn--primary","button_icon":"none","enable_preload_image":false}}},"block_order":["image_slide_FYcmPf","image_slide_W9cyQm","image_slide_gD7pcx","image_slide_B4R7VQ"],"name":"t:sections.image-with-text-slider.presets.name","settings":{"container":"fixed","color_scheme":"","image_height":"adapt","image_width":80,"image_position":"right","show_controls":true,"autoplay":true,"autoplay_delay":5,"desktop_controls_position":"start","mobile_controls_position":"inherit","padding_top":50,"padding_bottom":20}},"177822446565004d92":{"type":"_blocks","settings":{}},"spacer_6jHQg4":{"type":"spacer","name":"t:sections.spacer.name","settings":{"show_section_divider":false,"divider_width":"fixed","padding_top":10,"padding_bottom":0,"padding_top_mobile":24,"padding_bottom_mobile":0}},"17690703046b8926c9":{"type":"apps","blocks":{"judge_me_reviews_cards_carousel_AcNRGj":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/cards_carousel\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"show_sample_reviews":true,"reviews_selection":"all","products":[],"filter_pinned":false,"filter_featured":false,"filter_custom_tags":"","star_rating":"all","show_review_media":true,"display_order":"media_first","no_image_fallback":"review_text_only","max_reviews":20,"review_length":"medium","text_size":"small","image_ratio":"1.33","reviews_shown":5,"show_reviewer_name":true,"show_product_name":true,"hide_arrows_mobile":false,"arrows_position":"sides","max_width":1600,"corner_styling":"soft","header_text_color":"#000000","text_color":"#000000","card_color":"#f9f9f9","stars_color":"","arrows_color":"#000000","transition_speed":5,"header_text":"Customers are saying","show_average_rating":true,"rating_display":"default"}}},"block_order":["judge_me_reviews_cards_carousel_AcNRGj"],"settings":{"include_margins":true,"padding_top":0,"padding_bottom":0}},"multicolumn_nmUnhT":{"type":"multicolumn","blocks":{"column_BRAGdP":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/realArtist_2.png","title":"Mateo Nguyen","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h4","text":"<p>He got obsessed with curves, how a single cut could turn a flat board into something that looked alive. He spent years building for other studios before he had the confidence to trust his own hand. At Awefurni, he leads the sculptural work.<br\/><\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_bfjcBz":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/artist_5.png","title":"Daniel Tran","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h4","text":"<p>He studied architecture, spent a few years drawing buildings he found boring, then walked into a furniture workshop one afternoon and didn't leave. What he brought from architecture was precision , he thinks in joints, in how two surfaces meet, in the invisible structure that holds a piece together for decades.<br\/><\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_CE96qa":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/artist_4.png","title":"Andre Lam","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h4","text":"<p>Andre doesn't build furniture. He finishes it , and he'll be the first to tell you that's where a piece either comes to life or falls flat. At Awefurni, he selects the slabs, matches the grain across panels, and applies the finishes by hand. Natural Oak, Dark Walnut, Warm Walnut, every tone you see on the site went through Andre's hands.<br\/><\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}},"column_dfxPnb":{"type":"column","settings":{"image":"shopify:\/\/shop_images\/realArtist_1.png","title":"Tom Ly","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h4","text":"<p>Tom makes the pieces that are hard to explain in words, the abstract sculptures, the carved wall panels, the shapes that look like they belong in a gallery but somehow feel right in a living room. <br\/>Every organic edge table, every sculpted base, every triptych wall piece carries his eye for proportion.<br\/><\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none"}}},"block_order":["column_BRAGdP","column_bfjcBz","column_CE96qa","column_dfxPnb"],"name":"t:sections.multicolumn.name","settings":{"container":"fixed","color_scheme":"","section_header_alignment":"left","section_header_alignment_mobile":"inherit","subheading":"","heading":"Meet Our Wood Artists","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h1","description":"<p>Every piece at Awefurni begins the same way - a slab of raw wood and a pair of hands that know what's inside it.<\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline","button_icon":"none","content_alignment":"left","show_col_count":false,"show_image":true,"columns_desktop":4,"column_gap":"large","row_gap":"inherit","columns_mobile":"1","swipe_on_mobile":true,"show_section_divider":false,"divider_width":"fixed","padding_top":30,"padding_bottom":40}},"featured_blog_tAdBnq":{"type":"featured-blog","name":"t:sections.featured-blog.name","settings":{"container":"fixed","color_scheme":"","section_header_alignment":"left","section_header_alignment_mobile":"inherit","subheading":"","heading":"The Woodcraft Journal","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h2","description":"","text_size":"text-base","button_label":"Learn More","button_link":"shopify:\/\/blogs\/journal","button_style":"btn--underline","button_icon":"caret-right","blog":"journal","post_limit":3,"columns_desktop":3,"column_gap":"medium","row_gap":"large","columns_mobile":"1","swipe_on_mobile":true,"card_title_size":"h4","show_tags":true,"show_excerpt":true,"show_date":true,"show_author":true,"show_button":false,"padding_top":
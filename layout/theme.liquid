    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <meta name="p:domain_verify" content="9df977a202744cf7098b0a706020bd1d">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
        <meta name="facebook-domain-verification" content="4ztoik4f61iizq3xdukgpli433udqj">
    <meta name="google-site-verification" content="lL8GBdjVz1wn1XMVs5Gpj5ZweCWn_D9j3TwZQdaUMko" />
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      assign adm_page_title = page_title
      if request.page_type == 'product'
        case product.handle
          when 'ondara-fluid-base-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Ondara Fluid Base Solid Wood Coffee Table'
          when 'kelvington-fluid-base-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Kelvington Fluid Base Solid Wood Coffee Table'
          when 'elara-fluid-base-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Elara Fluid Base Solid Wood Coffee Table'
          when 'sorello-live-edge-solid-wood-tv-stand-for-living-room'
            assign adm_page_title = 'Sorello Live Edge Solid Wood TV Stand'
          when 'edgevale-live-edge-solid-wood-tv-stand-for-living-room'
            assign adm_page_title = 'Edgevale Live Edge Solid Wood TV Stand'
          when 'solen-curved-solid-wood-tv-console-with-drawers-for-living-room'
            assign adm_page_title = 'Solen Curved Solid Wood TV Console with Drawers'
          when 'floreno-curved-solid-wood-tv-console-for-living-room'
            assign adm_page_title = 'Floreno Curved Solid Wood TV Console'
          when 'vireon-slab-live-edge-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Vireon Slab Live Edge Solid Wood Coffee Table'
          when 'ondule-slab-live-edge-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Ondule Slab Live Edge Solid Wood Coffee Table'
          when 'kasper-swirl-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Kasper Swirl Solid Wood Coffee Table'
          when 'sugi-spiral-solid-wood-coffee-table-for-living-room'
            assign adm_page_title = 'Sugi Spiral Solid Wood Coffee Table'
          when 'bodhi-organic-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Bodhi Organic Solid Wood Corner Shelf'
          when 'dallin-organic-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Dallin Organic Solid Wood Corner Shelf'
          when 'delios-curved-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Delios Curved Solid Wood Corner Shelf'
          when 'inigo-soft-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Inigo Soft Solid Wood Corner Shelf'
          when 'isidore-organic-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Isidore Organic Solid Wood Corner Shelf'
          when 'pax-floating-solid-wood-corner-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Pax Floating Solid Wood Corner Shelf'
          when 'zane-raw-edge-solid-wood-corner-floating-shelf-for-furniture-decor-and-living-room'
            assign adm_page_title = 'Zane Raw Edge Solid Wood Corner Floating Shelf'
        endcase
      endif
    -%}
    <title>
      {{- adm_page_title | escape -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if template == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless adm_page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- liquid
      assign adm_meta_description = page_description
      if request.page_type == 'product' and product.metafields.global.description_tag == blank
        capture adm_meta_description
          echo product.title | strip | truncate: 90
          echo '. Compare sizes and finishes, or ask Awefurni about custom options.'
        endcapture
      elsif request.page_type == 'blog' and current_tags != blank
        assign adm_topic = current_tags | join: ', '
        capture adm_meta_description
          echo adm_topic
          echo ' articles from the Awefurni Journal. Explore furniture ideas and practical guidance for planning your home.'
        endcapture
      elsif adm_meta_description == blank
        case request.path
          when '/collections/all'
            assign adm_meta_description = 'Explore Awefurni solid wood furniture for your home. Browse coffee tables, TV stands, cabinets and more, with custom size and finish enquiries available.'
          when '/policies/privacy-policy'
            assign adm_meta_description = 'Read the Awefurni privacy policy to understand how personal information is collected, used and shared when you visit or purchase from our store.'
          when '/policies/refund-policy'
            assign adm_meta_description = 'Read the Awefurni return and refund policy for information on eligibility, requests and the process to follow if there is an issue with your order.'
          when '/policies/shipping-policy'
            assign adm_meta_description = 'Read the Awefurni shipping policy for delivery information. Contact our team to confirm the estimated timeframe and arrangements for your selected furniture.'
          when '/policies/terms-of-service'
            assign adm_meta_description = 'Read the Awefurni terms of service for the conditions that apply when you use our website and purchase products from our online furniture store.'
          when '/cart'
            assign adm_meta_description = 'Review the furniture and selected options in your Awefurni shopping cart before checkout. Contact our team if you need help with a custom order.'
        endcase
      endif
    -%}
    {%- if adm_meta_description != blank -%}
      <meta name="description" content="{{ adm_meta_description | strip | escape }}">
    {%- endif -%}

    {%- liquid
      render 'meta-tags'
      render 'css-variables'

      echo 'vendor.aio.min.css' | asset_url | stylesheet_tag: preload: true
      echo 'theme.aio.min.css' | asset_url | stylesheet_tag: preload: true

      if settings.enable_product_compare
        echo 'compare.aio.min.css' | asset_url | stylesheet_tag: preload: true
      endif

      if enable_rtl
        echo 'rtl.aio.min.css' | asset_url | stylesheet_tag: preload: true
      endif
    -%}

    {{ content_for_header }}
    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {%- if request.page_type contains 'customers/' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'js-variables' -%}

    {% comment %} Custom metafield for head tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_head.value }}
    {% comment %} End custom metafield for head tag like GTag tracking {% endcomment %}

    <style>
      /* Transparent — only when the badge sits on top of a product photo */
      .product-card__badge .f-badge--hot { background: rgba(0, 0, 0, 0.72) !important; }
      .product-card__badge .f-badge--new { background: rgba(247, 243, 236, 0.8) !important; }

      /* Solid — product page info column, no photo behind it */
      .product__badges .f-badge--hot { background: #000000 !important; }
      .product__badges .f-badge--new { background: #F7F3EC !important; }

      .menu__item .icon-caret-down { display: none; }

      .menu__item {
        padding-left: 2.4rem;
        padding-right: 2.4rem;
      }
      
      .page-width--full {
      --page-padding: 0 !important;
      }
      .collection-hero__inner {
        border-radius: 0 !important;
      }

    </style>

  </head>

  <body
    class="{{ request.page_type }}-template {{ template.suffix }} blocks-corner--{{ settings.blocks_corner_radius }}{% if request.design_mode %} shopify-design-mode{% endif %}"
    data-initializing
  >
        <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WD8GLGTP"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

    {% comment %} Custom metafield for body tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_body.value }}
    {% comment %} End custom metafield for body tab like GTag tracking {% endcomment %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- liquid
      if settings.enable_page_transition
        render 'page-transition'
      endif
    -%}

    <div class="site-wrapper min-height-screen">
      {% sections 'header-group' %}

      <main id="MainContent" class="main-content content-for-layout focus-none" role="main" tabindex="-1">
        {% capture ICART_FULL_PAGE_LAYOUT %}{{ content_for_layout }}{% endcapture -%}
        {%- include 'icart-variables', ICART_FULL_PAGE_LAYOUT: ICART_FULL_PAGE_LAYOUT %}
      </main>

      <nav class="page-width" aria-label="Find furniture and planning guides" style="padding-block:2rem;border-top:1px solid rgba(0,0,0,.12)">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr));gap:1.5rem 2rem">
          <div><p style="margin:0 0 .75rem;font-weight:600">Shop by room</p><ul style="list-style:none;display:grid;gap:.5rem;padding:0;margin:0">
            <li><a href="{{ routes.collections_url }}/living-room">Living room furniture</a></li>
            <li><a href="{{ routes.collections_url }}/dining-kitchen">Dining and kitchen furniture</a></li>
            <li><a href="{{ routes.collections_url }}/bedroom">Bedroom furniture</a></li>
            <li><a href="{{ routes.collections_url }}/bathroom">Bathroom furniture</a></li>
            <li><a href="{{ routes.collections_url }}/home-office">Home office furniture</a></li>
          </ul></div>
          <div><p style="margin:0 0 .75rem;font-weight:600">Shop by type</p><ul style="list-style:none;display:grid;gap:.5rem;padding:0;margin:0">
            <li><a href="{{ routes.collections_url }}/solid-wood-coffee-tables">Solid wood coffee tables</a></li>
            <li><a href="{{ routes.collections_url }}/solid-wood-tv-stands">Solid wood TV stands and media consoles</a></li>
            <li><a href="{{ routes.collections_url }}/tables">All tables</a></li>
            <li><a href="{{ routes.collections_url }}/cabinets">Cabinets and storage</a></li>
            <li><a href="{{ routes.collections_url }}/chairs">Chairs</a></li>
            <li><a href="{{ routes.collections_url }}/shelves">Shelves</a></li>
            <li><a href="{{ routes.collections_url }}/new-arrival">New arrivals</a></li>
            <li><a href="{{ routes.collections_url }}/home-highlights">Home highlights</a></li>
          </ul></div>
          <div><p style="margin:0 0 .75rem;font-weight:600">Planning and care</p><ul style="list-style:none;display:grid;gap:.5rem;padding:0;margin:0">
            <li><a href="{{ routes.root_url }}blogs/journal">Awefurni Journal</a></li>
            <li><a href="{{ routes.root_url }}blogs/journal/tagged/how-to">Furniture how-to guides</a></li>
            <li><a href="{{ routes.root_url }}blogs/journal/tagged/trends">Furniture trends and design stories</a></li>
            <li><a href="{{ routes.root_url }}pages/about">About Awefurni and custom orders</a></li>
            <li><a href="{{ routes.root_url }}pages/contact">Contact Awefurni</a></li>
            <li><a href="{{ routes.root_url }}policies/shipping-policy">Shipping information</a></li>
          </ul></div>
        </div>
      </nav>

      {% sections 'footer-group' %}
    </div>

    {% sections 'overlay-group' %}
    {%- liquid
      if settings.enable_back_to_top
        render 'back-to-top'
      endif
    -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% if settings.pcard_show_quickview_button or settings.pcard_choose_options_actions == 'open_popup' %}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {%- if settings.enable_product_compare -%}
      <script src="{{ 'compare.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      (function patchShopifyChat() {
        function apply() {
          const host = document.querySelector('#shopify-chat inbox-online-store-chat');
          if (!host || !host.shadowRoot) return;

          // chèn CSS ngay trong shadow root để ghi đè
          if (!host.shadowRoot.getElementById('chat-patch-style')) {
            const st = document.createElement('style');
            st.id = 'chat-patch-style';
            st.textContent = `
            .info-modal{display:block!important;flex-direction:unset!important}
            .info-modal__wrapper{display:block!important}
            .chat-app chat-app--is-open chat-app--is-mobile{max-height:840px !important; }
          `;
            host.shadowRoot.appendChild(st);
          }
        }
        const iv = setInterval(apply, 300);
        setTimeout(() => clearInterval(iv), 6000);
        document.addEventListener('shopify:section:load', apply);
      })();
    </script>

    {% comment %} easify-dev {% endcomment %}
    <style>
      body .tpo_custom_livePreviewHidden {
        display: none !important;
      }
    </style>

    <script>
      document.addEventListener('tpo_loaded', () => {
        const domHandleClickLivePreview = document.querySelectorAll(
          '.product__media-gallery-thumbails .swiper-slide, .product__media-gallery-viewer-wrap .swiper-button-next , .product__media-gallery-viewer-wrap .swiper-controls .swiper-button-prev'
        );

        function HandleLivePreview() {
          const product__thumbs_index = document
            .querySelector('.product__media-gallery-thumbails .swiper-slide.swiper-slide-thumb-active')
            .getAttribute('aria-label')
            .split('/');
          const tpoCanvas = document.querySelector('.tpo_canvas_builder');
          const propOfLivePreview = Konva.stages[0].findOne('#tpo_custom_background_image').attrs;
          if (
            (propOfLivePreview.preview_options === 'FIRST_IMAGE' && product__thumbs_index[0].trim() !== '1') ||
            (propOfLivePreview.preview_options === 'LAST_IMAGE' &&
              product__thumbs_index[0].trim() !== product__thumbs_index[1])
          ) {
            tpoCanvas.classList.add('tpo_custom_livePreviewHidden');
          } else {
            tpoCanvas.classList.remove('tpo_custom_livePreviewHidden');
          }
        }

        domHandleClickLivePreview.forEach((element) => {
          element.addEventListener('click', HandleLivePreview);
        });
      });
    </script>

    {% render 'quick-view-color-swatches' %}

  </body>
</html>

  <style>
    @media screen and (max-width: 650px){
.jdgm-testimonials-carousel, .jdgm-videos-carousel, .jdgm-cards-carousel {
    .jdgm-title {
        -webkit-line-clamp: 3 !important;
        font-size:25px !important;
    }
}
}
  </style>

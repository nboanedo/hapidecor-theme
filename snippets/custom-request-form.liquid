{%- comment -%}
  Snippet: custom-request-form.liquid
  Purpose: In-product-info custom order request form (timberustic-style)
  Theme: Pillar by Foxecom
  Place: snippets/product-information-blocks.liquid — after {%- endfor -%}, before closing </div>
  Submission: Shopify native contact form → store notification email
{%- endcomment -%}

{%- assign product_url = shop.url | append: product.url -%}

<div class="custom-request-wrapper">

  <button
    type="button"
    class="custom-request-toggle"
    aria-expanded="false"
    aria-controls="custom-request-panel"
    id="custom-request-toggle"
  >
    <span class="custom-request-toggle__label">SEND CUSTOM REQUEST</span>
    <span class="custom-request-toggle__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </button>

  <div
    class="custom-request-panel"
    id="custom-request-panel"
    role="region"
    aria-labelledby="custom-request-toggle"
    hidden
  >
    {%- form 'contact', id: 'CustomRequestForm' -%}

      <input type="hidden" name="contact[tags]"          value="custom-request">
      <input type="hidden" name="contact[subject]"       value="Custom Request — {{ product.title | escape }}">
      <input type="hidden" name="contact[product_title]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[product_url]"   value="{{ product_url | escape }}">

      {%- if form.posted_successfully? -%}
        <p class="custom-request-success" role="alert">
          ✓ Request sent! We'll get back to you within 1–2 business days.
        </p>
      {%- endif -%}

      {%- if form.errors -%}
        <p class="custom-request-error" role="alert">
          {{ form.errors | default_errors }}
        </p>
      {%- endif -%}

      <div class="custom-request-product-ref">
        <div class="custom-request-product-ref__row">
          <span class="custom-request-product-ref__label">Product:</span>
          <span class="custom-request-product-ref__value">{{ product.title }}</span>
        </div>
        <div class="custom-request-product-ref__row">
          <span class="custom-request-product-ref__label">URL:</span>
          <a
            class="custom-request-product-ref__url"
            href="{{ product_url }}"
            target="_blank"
            rel="noopener"
          >View this product: {{ product.title | escape }}</a>
        </div>
      </div>

      <div class="custom-request-fields">

        <div class="custom-request-field">
          <label class="custom-request-label" for="CustomRequestEmail">
            Email <span class="custom-request-required" aria-hidden="true">*</span>
          </label>
          <input
            class="custom-request-input"
            type="email"
            id="CustomRequestEmail"
            name="contact[email]"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >
        </div>

        <div class="custom-request-field">
          <label class="custom-request-label" for="CustomRequestPhone">
            Phone
            <span class="custom-request-optional">(optional)</span>
          </label>
          <input
            class="custom-request-input"
            type="tel"
            id="CustomRequestPhone"
            name="contact[phone]"
            placeholder="+1 555 000 0000"
            autocomplete="tel"
          >
        </div>

        <div class="custom-request-field">
          <label class="custom-request-label" for="CustomRequestMessage">
            Describe your customization request
          </label>
          <textarea
            class="custom-request-input custom-request-textarea"
            id="CustomRequestMessage"
            name="contact[body]"
            placeholder="Tell us size, wood tone, finish, deadline…"
            rows="5"
            required
          ></textarea>
        </div>

      </div>

      <button type="submit" class="custom-request-submit">
        Send request
      </button>

    {%- endform -%}
  </div>

</div>


{%- comment -%} ===================== STYLES ===================== {%- endcomment -%}



{%- comment -%} ===================== SCRIPT ===================== {%- endcomment -%}
